@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<section class="container auth-wrap"><div class="auth-intro"><h1>Accede a tu cuenta</h1><p>Inicia sesión para consultar tu perfil y administrar tu contraseña.</p></div><div class="card auth-card"><h2>Iniciar sesión</h2><p class="card-subtitle">Introduce tu correo y contraseña.</p><form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><input asp-for="ReturnUrl" type="hidden" />
    <div class="field"><label asp-for="Email">Correo electrónico</label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
    <div class="field"><label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span></div>
    <div class="form-options"><label class="check-label"><input asp-for="RememberMe" /> Recordarme</label><a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a></div>
    <button class="button button-primary button-full" type="submit">Entrar</button>
</form><p class="form-footer">¿No tienes una cuenta? <a asp-action="Register">Regístrate</a></p></div></section>

