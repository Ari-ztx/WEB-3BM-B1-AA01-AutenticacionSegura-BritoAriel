@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Recuperar contraseña"; }
<section class="container narrow"><div class="card auth-card"><p class="eyebrow">RECUPERACIÓN DE CUENTA</p><h1>¿Olvidaste tu contraseña?</h1><p class="card-subtitle">Introduce tu correo y te enviaremos instrucciones para recuperar el acceso.</p><form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="field"><label asp-for="Email">Correo electrónico</label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
    <button class="button button-primary button-full" type="submit">Enviar instrucciones</button>
</form><p class="form-footer"><a asp-action="Login">← Volver a iniciar sesión</a></p></div></section>
