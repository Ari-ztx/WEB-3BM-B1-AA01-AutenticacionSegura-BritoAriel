@model ResetPasswordViewModel
@{ ViewData["Title"] = "Restablecer contraseña"; }
<section class="container narrow"><div class="card auth-card"><p class="eyebrow">RECUPERACIÓN DE CUENTA</p><h1>Crea una nueva contraseña</h1><p class="card-subtitle">Introduce y confirma tu nueva contraseña para recuperar el acceso.</p><form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><input asp-for="Token" type="hidden" />
    <div class="field"><label asp-for="Email">Correo electrónico</label><input asp-for="Email" type="email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div>
    <div class="field"><label asp-for="Password">Nueva contraseña</label><input asp-for="Password" type="password" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span></div>
    <div class="field"><label asp-for="ConfirmPassword">Confirmar contraseña</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
    <button class="button button-primary button-full" type="submit">Guardar contraseña</button>
</form></div></section>
