@model ProfileViewModel
@{ ViewData["Title"] = "Mi perfil"; }
<section class="container page-section"><div class="page-heading"><div><p class="eyebrow">ÁREA PERSONAL</p><h1>Mi perfil</h1><p>Consulta los datos de tu cuenta y cuida tu acceso.</p></div></div><div class="profile-grid"><article class="card profile-card"><div class="section-heading"><div><span class="section-icon" aria-hidden="true">◎</span><h2>Información personal</h2></div></div><dl class="details"><div><dt>Nombre completo</dt><dd>@Model.FullName</dd></div><div><dt>Correo electrónico</dt><dd>@Model.Email</dd></div></dl></article><article class="card profile-card"><div class="section-heading"><div><span class="section-icon" aria-hidden="true">◇</span><h2>Seguridad</h2></div></div><p>Si deseas actualizar tu contraseña, necesitarás introducir la actual.</p><a class="button button-secondary" asp-action="ChangePassword">Cambiar contraseña <span aria-hidden="true">→</span></a></article></div></section>
