<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - Taller Seguro</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header"><div class="container header-inner">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">T</span><span>Taller <strong>Seguro</strong></span></a>
        <nav aria-label="Navegación principal">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Profile" asp-action="Index">Mi perfil</a>
                @if (User.IsInRole("Administrador")) { <a asp-controller="Admin" asp-action="Index">Administración</a> }
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form"><button class="nav-button" type="submit">Cerrar sesión</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Iniciar sesión</a><a class="nav-cta" asp-controller="Account" asp-action="Register">Crear cuenta</a>
            }
        </nav>
    </div></header>
    <main id="contenido" class="main-content">
        @if (TempData["Success"] is string success) { <div class="container"><div class="alert alert-success" role="status">@success</div></div> }
        @if (TempData["Error"] is string error) { <div class="container"><div class="alert alert-error" role="alert">@error</div></div> }
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container footer-inner"><span>Taller Seguro</span><span>Acceso y gestión de cuenta</span></div></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
