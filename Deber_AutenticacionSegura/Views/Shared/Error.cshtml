@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="container narrow"><div class="card message-card"><p class="eyebrow">HA OCURRIDO UN ERROR</p><h1>No pudimos completar tu solicitud</h1><p>Inténtalo nuevamente. Si el problema continúa, contacta con un administrador.</p>@if (Model.ShowRequestId) { <p>Referencia: <code>@Model.RequestId</code></p> }<a class="button button-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a></div></section>
